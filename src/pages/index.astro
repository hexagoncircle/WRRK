---
import "../styles/reset.css";
import "../styles/utils.css";
import "../styles/base.css";

import NumberField from "../components/NumberField.astro";
import TimerPlayer from "../components/TimerPlayer.astro";
import {
  DURATION_MAX,
  DURATION_MIN,
  DURATION_STEP,
  DEFAULT_CONFIG,
  ROUNDS_MAX,
} from "../scripts/model.js";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />
    <meta name="description" content="A simple interval timer for workouts." />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>Interval Timer</title>
    <link rel="stylesheet" href="https://use.typekit.net/yys8fwy.css" />
  </head>
  <body>
    <main class="screen" data-app-root data-status="idle">
      <h1 class="sr-only">Interval Timer</h1>
      <fieldset class="setup">
        <legend class="sr-only">Setup</legend>
        <NumberField
          label="work"
          name="workSeconds"
          value={DEFAULT_CONFIG.workSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="rest"
          name="restSeconds"
          value={DEFAULT_CONFIG.restSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="rounds"
          name="rounds"
          value={DEFAULT_CONFIG.rounds}
          min={1}
          max={ROUNDS_MAX}
          step={1}
        />
      </fieldset>
      <TimerPlayer />
    </main>
    <script>
      import "../scripts/app.js";
    </script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* Service worker registration is best-effort. */
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .screen {
    display: flex;
    flex-direction: column-reverse;
    column-gap: 15vmin;
    width: fit-content;
    min-height: 100%;
    margin-inline: auto;
  }

  .setup {
    border: none;
    padding: 0;
    margin: 0;
    margin-block-start: auto;
    flex: 0 1 auto;
    display: flex;
    row-gap: 4vmin;
    padding-block: 5vmin;
    justify-content: space-between;
    transition: color 0.3s ease-out;
  }

  .screen:not([data-status="idle"]) > .setup {
    color: var(--color-fg-muted);
    pointer-events: none;
    user-select: none;
  }

  .setup:not(:hover):focus-within :global(.number-field:not(:focus-within)) {
    color: var(--color-fg-muted);
  }

  @media (min-aspect-ratio: 1000/600) {
    .screen {
      flex-direction: row;
      min-height: unset;
      height: fit-content;
      margin-block: auto;
    }

    .setup {
      flex-direction: column;
      padding-block: unset;
      margin-block-start: unset;
    }
  }
</style>
