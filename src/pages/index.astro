---
import "../styles/reset.css";
import "../styles/utils.css";
import "../styles/base.css";

import SoundControl from "../components/SoundControl.astro";
import NumberField from "../components/NumberField.astro";
import TimerPlayer from "../components/TimerPlayer.astro";
import IntroScreen from "../components/IntroScreen.astro";
import {
  DURATION_MAX,
  DURATION_MIN,
  DURATION_STEP,
  DEFAULT_CONFIG,
  ROUNDS_MAX,
} from "../scripts/model.js";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.documentElement.dataset.intro = navigator.onLine && !reduce ? "pending" : "done";
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />
    <meta name="description" content="A simple interval timer for workouts." />
    <title>WRRK</title>
    <meta property="og:title" content="WRRK Timer" />
    <meta
      property="og:description"
      content="A simple interval timer for workouts. Work, rest, repeat."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wrrk.app" />
    <meta property="og:image" content="https://wrrk.app/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="WRRK Timer" />
    <meta
      name="twitter:description"
      content="A simple interval timer for workouts. Work, rest, repeat."
    />

    <meta name="twitter:image" content="https://wrrk.app/og-image.png" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/yys8fwy.css" />
  </head>
  <body>
    <IntroScreen />
    <main id="app" class="screen" data-status="idle">
      <h1 class="sr-only">WRRK</h1>
      <SoundControl class="sound" />
      <form class="settings">
        <h2 class="sr-only">Timer settings</h2>
        <NumberField
          label="work"
          name="workSeconds"
          value={DEFAULT_CONFIG.workSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="rest"
          name="restSeconds"
          value={DEFAULT_CONFIG.restSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="rounds"
          name="rounds"
          value={DEFAULT_CONFIG.rounds}
          min={1}
          max={ROUNDS_MAX}
          step={1}
        />
      </form>
      <TimerPlayer />
    </main>
    <script>
      import "../scripts/app.js";
    </script>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" }).catch(() => {});
      }
    </script>
  </body>
</html>

<style is:global>
  /* Timer stays painted under the white intro so the digit dance can start before the curtain lifts. */
  html[data-intro="pending"] #app {
    pointer-events: none;
  }

  /* Offline / head script sets done before JS removes #intro — don't flash the overlay.
     .is-exiting keeps the curtain visible while it clips away after finishIntro(). */
  html[data-intro="done"] #intro:not(.is-exiting) {
    display: none;
  }
</style>

<style>
  .screen {
    display: flex;
    flex-direction: column-reverse;
    column-gap: 3em;
    row-gap: 1.6em;
    width: fit-content;
    min-height: 100%;
    margin-inline: auto;
    user-select: none;
  }

  .settings {
    margin: 0;
    margin-block-start: auto;
    flex: 0 1 auto;
    display: flex;
    row-gap: 1.2em;
    justify-content: space-between;
    transition: color 300ms ease-out;

    &:focus-within :global(number-field:not(:focus-within)) {
      color: var(--color-fg-muted);
    }
  }

  .screen:not([data-status="idle"]) > .settings {
    color: var(--color-fg-muted);
    pointer-events: none;
    user-select: none;
  }

  .sound {
    position: fixed;
    top: 1rem;
    right: 0.75rem;
  }

  @media (min-aspect-ratio: 6/5) {
    .screen {
      flex-direction: row;
      height: fit-content;
      margin-block: auto;
    }

    .settings {
      flex-direction: column;
      margin-block-start: 0;
    }
  }

  @media (width <= 24rem) or (height <= 28rem) {
    .settings {
      flex-direction: column;
    }
  }
</style>
