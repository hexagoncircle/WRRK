---
import "../styles/reset.css";
import "../styles/utils.css";
import "../styles/base.css";

import NumberField from "../components/NumberField.astro";
import TimerPlayer from "../components/TimerPlayer.astro";
import {
  DURATION_MAX,
  DURATION_MIN,
  DURATION_STEP,
  DEFAULT_CONFIG,
  ROUNDS_MAX,
} from "../scripts/model.js";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />
    <meta name="description" content="A simple interval timer for workouts." />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>Interval Timer</title>
  </head>
  <body>
    <main class="screen" data-app-root>
      <h1 class="sr-only">Interval Timer</h1>
      <fieldset class="controls">
        <legend class="sr-only">Controls</legend>
        <NumberField
          label="Work"
          name="workSeconds"
          value={DEFAULT_CONFIG.workSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="Rest"
          name="restSeconds"
          value={DEFAULT_CONFIG.restSeconds}
          min={DURATION_MIN}
          max={DURATION_MAX}
          step={DURATION_STEP}
          duration
        />
        <NumberField
          label="Rounds"
          name="rounds"
          value={DEFAULT_CONFIG.rounds}
          min={1}
          max={ROUNDS_MAX}
          step={1}
        />
      </fieldset>
      <TimerPlayer class="player" />
    </main>
    <script>
      import "../scripts/app.js";
    </script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* Service worker registration is best-effort. */
          });
        });
      }
    </script>
  </body>
</html>

<style>
  html {
    height: 100%;
  }

  body {
    display: flex;
    width: 100%;
    /* min-height (not height) so the page can scroll when the keyboard shrinks the viewport. */
    min-height: 100%;
  }

  .screen {
    display: flex;
    flex-direction: column-reverse;
    margin: auto;
    gap: 2rem;
    width: 100%;
    min-height: 100%;
    justify-content: center;
    align-items: center;
  }

  .controls {
    border: none;
    row-gap: 2rem;
    padding: 0;
    margin: 0;
    flex: 0 1 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .player {
    flex: 1 1 20rem;
  }

  @media (height < 30rem) {
    .screen {
      flex-direction: row;
    }

    .controls {
      flex-direction: column;
    }
  }
</style>
