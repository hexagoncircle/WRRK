---
const characters = ["jumprope", "run", "stretch", "weights"] as const;
---

<div id="intro" class="intro-screen" aria-hidden="true">
  <div class="intro-grid">
    {
      characters.map((id) => (
        <div class="intro-panel" data-src={`/wrrk-${id}.json`}>
          <div class="intro-figure">
            <img src={`/wrrk-${id}.svg`} alt="" width="144" height="144" decoding="async" />
          </div>
        </div>
      ))
    }
  </div>
  <div class="intro-logotype">
    <img src="/wrrk-logotype.svg" alt="" width="144" height="108" decoding="async" />
  </div>
</div>

<style>
  .intro-screen {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100%;
    height: 100%;
    background: #ffffff;
    container-type: size;
    container-name: intro;
  }

  .intro-grid {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .intro-panel {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    container-type: size;
    visibility: hidden;
    overflow: visible;
  }

  .intro-panel.is-shown {
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-panel {
      visibility: visible;
    }
  }

  .intro-figure {
    position: relative;
    width: min(36vmin, 100%);
    height: auto;
    aspect-ratio: 1;
    overflow: visible;
  }

  .intro-figure :global(img),
  .intro-figure :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
  }

  /* Mounted by intro.js — no Astro scope attr, so :global */
  .intro-figure :global(.intro-lottie) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    overflow: visible;
  }

  .intro-figure :global(.intro-lottie.is-ready) {
    opacity: 1;
  }

  .intro-logotype {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
  }

  .intro-logotype img {
    display: block;
    width: min(60vmin, 80%);
    height: auto;
    aspect-ratio: 144 / 108;
  }
</style>
