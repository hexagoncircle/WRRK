---
const characters = ["jumprope", "run", "stretch", "weights"] as const;
---

<div id="intro" class="intro-screen" aria-hidden="true">
  <div class="intro-grid">
    {
      characters.map((id) => (
        <div class="intro-panel" data-src={`/wrrk-${id}.json`}>
          <img src={`/wrrk-${id}.svg`} alt="" width="144" height="144" />
        </div>
      ))
    }
  </div>
  <div class="intro-logotype">
    <img src="/wrrk-logotype.svg" alt="" width="144" height="108" fetchpriority="high" />
  </div>
</div>

<style>
  .intro-screen {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    background: #ffffff;
  }

  .intro-grid {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .intro-panel {
    position: relative;
    place-self: center;
    width: min(36vmin, 100%);
    aspect-ratio: 1;
    min-width: 0;
    min-height: 0;
  }

  .intro-panel > * {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
  }

  /* Lottie clips each SVG to comp w×h; jump-rope arcs need to paint past that. */
  .intro-panel svg {
    overflow: visible;
  }

  .intro-panel svg > g[clip-path] {
    clip-path: none;
  }

  .intro-logotype {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0.001;

    img {
      display: block;
      width: 60vmin;
      height: auto;
    }
  }
</style>
