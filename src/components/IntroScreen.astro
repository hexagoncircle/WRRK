---
const characters = ["jumprope", "run", "stretch", "weights"] as const;
---

<div id="intro" class="intro-screen" aria-hidden="true">
  {
    characters.map((id) => (
      <div class="intro-panel" data-src={`/wrrk-${id}.json`}>
        <img src={`/wrrk-${id}.svg`} alt="" width="144" height="144" />
      </div>
    ))
  }
  <img
    class="intro-logotype"
    src="/wrrk-logotype.svg"
    alt=""
    width="144"
    height="108"
    fetchpriority="high"
  />
</div>

<style>
  .intro-screen {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--color-bg-inverse);
  }

  .intro-panel {
    position: relative;
    place-self: center;
    width: min(35vmin, 100%);

    > * {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Lottie builds this SVG without a scoped attribute. */
    > :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    > :global(svg[hidden]) {
      display: none;
    }

    /* Comp clip cuts off jump-rope arcs that paint past w×h. */
    :global(svg > g[clip-path]) {
      clip-path: none;
    }
  }

  .intro-logotype {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 58vmin;
    height: auto;
    translate: -50% -50%;
    pointer-events: none;
    opacity: 0.001;
  }
</style>
