---
const characters = ["jumprope", "run", "stretch", "weights"] as const;
---

<div id="intro" class="intro-screen" aria-hidden="true">
  {
    characters.map((id) => (
      <div class="intro-panel" data-src={`/wrrk-${id}.json`}>
        <img src={`/wrrk-${id}.svg`} alt="" width="144" height="144" />
      </div>
    ))
  }
  <img class="intro-logotype" src="/wrrk-logotype.svg" alt="" width="144" height="108" />
</div>

<script is:inline>
  (() => {
    const intro = document.getElementById("intro");
    if (!(intro instanceof HTMLElement)) return;

    if (!navigator.onLine) return;

    const root = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      intro.dataset.status = "static";
      intro.dataset.shownAt = String(Date.now());
      setTimeout(() => {
        if (intro.dataset.status === "static") intro.dataset.logo = "";
      }, 500);
    } else {
      intro.dataset.status = "pending";
    }
    root.setAttribute("inert", "");

    // Unlock if the module never takes over. "playing" owns its own removal.
    setTimeout(() => {
      const status = intro.dataset.status;
      if (status === "playing" || !intro.hasAttribute("data-status")) return;
      delete intro.dataset.status;
      root.removeAttribute("inert");
    }, 8000);
  })();
</script>

<style>
  .intro-screen {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    width: 100%;
    height: 100%;
    user-select: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--color-bg-inverse);
    clip-path: inset(0% 0% 0% 0%);
    translate: 0 0;

    &:not([data-status]) {
      display: none;
    }
  }

  .intro-panel {
    position: relative;
    place-self: center;
    width: min(35vmin, 100%);
    scale: 1;

    > * {
      display: block;
      width: 100%;
      height: 100%;
    }

    > :global(svg) {
      display: none;
      overflow: visible;
    }

    &[data-ready] {
      > img {
        display: none;
      }

      > :global(svg) {
        display: block;
      }
    }
  }

  .intro-logotype {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 58vmin;
    height: auto;
    translate: -50% -50%;
    rotate: 0deg;
    scale: 1;
    opacity: 0.001;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-logotype {
      opacity: 0;
      scale: 1.03;
      rotate: -5deg;
      transition: 0.2s ease-out;
      transition-property: opacity, scale;
    }

    .intro-screen[data-logo] .intro-logotype {
      opacity: 1;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro-screen[data-status="playing"] {
      animation: intro-exit 0.4s cubic-bezier(0.16, 1, 0.3, 1) 2.4s forwards;

      .intro-logotype {
        animation: logo-slam 1s 1.5s forwards;
      }
      .intro-panel {
        animation: figure-jump 0.2s 1.56s forwards;
      }
    }
  }

  @keyframes figure-jump {
    0% {
      scale: 1;
    }
    30% {
      scale: 1.1;
    }
    100% {
      scale: 1;
    }
  }

  @keyframes intro-exit {
    to {
      clip-path: inset(0% 0% 100% 0%);
      translate: 0 -5px;
    }
  }

  @keyframes logo-slam {
    0% {
      opacity: 1;
      scale: 1.8;
      rotate: 0deg;
      /* prettier-ignore */
      animation-timing-function: linear(0, 0.029 1.3%, 0.119 2.8%, 0.659 8.7%, 0.871 11.6%, 1.009 14.6%, 1.052 16.2%, 1.078 17.9%, 1.088 19.7%, 1.085 21.7%, 1.014 31.4%, 0.993 38%, 1.001 57.6%, 1);
    }
    34%,
    100% {
      opacity: 1;
      scale: 1;
      rotate: -5deg;
    }
  }
</style>
