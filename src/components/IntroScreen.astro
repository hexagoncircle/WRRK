---
const characters = ["jumprope", "run", "stretch", "weights"] as const;
---

<div id="intro" class="intro-screen" aria-hidden="true">
  {
    characters.map((id) => (
      <div class="intro-panel" data-src={`/wrrk-${id}.json`}>
        <img src={`/wrrk-${id}.svg`} alt="" width="144" height="144" />
      </div>
    ))
  }
  <img
    class="intro-logotype"
    src="/wrrk-logotype.svg"
    alt=""
    width="144"
    height="108"
    fetchpriority="high"
  />
</div>

<style>
  .intro-screen {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--color-bg-inverse);
    clip-path: inset(0% 0% 0% 0%);
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-property: clip-path, translate;
  }

  .intro-screen.is-exiting {
    clip-path: inset(0% 0% 100% 0%);
    translate: 0 -5px;
  }

  .intro-panel {
    position: relative;
    place-self: center;
    width: min(35vmin, 100%);
    animation: figure-jump 0.2s 0.06s both;
    animation-play-state: paused;

    > * {
      display: block;
      width: 100%;
      height: 100%;
    }

    > :global(svg) {
      display: none;
      overflow: visible;
    }

    &.is-ready {
      > img {
        display: none;
      }

      > :global(svg) {
        display: block;
      }
    }
  }

  .intro-screen.is-slamming .intro-panel {
    animation-play-state: running;
  }

  @keyframes figure-jump {
    0% {
      scale: 1;
    }
    30% {
      scale: 1.1;
    }
    100% {
      scale: 1;
    }
  }

  .intro-logotype {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 58vmin;
    height: auto;
    translate: -50% -50%;
    opacity: 0.001;
    animation: logo-slam 1s both;
    animation-play-state: paused;
  }

  .intro-screen.is-slamming .intro-logotype {
    opacity: 1;
    animation-play-state: running;
  }

  @keyframes logo-slam {
    from {
      scale: 1.8;
      rotate: 0deg;
      /* prettier-ignore */
      animation-timing-function: linear(0, 0.029 1.3%, 0.119 2.8%, 0.659 8.7%, 0.871 11.6%, 1.009 14.6%, 1.052 16.2%, 1.078 17.9%, 1.088 19.7%, 1.085 21.7%, 1.014 31.4%, 0.993 38%, 1.001 57.6%, 1);
    }

    34%,
    100% {
      scale: 1;
      rotate: -5deg;
    }
  }
</style>
