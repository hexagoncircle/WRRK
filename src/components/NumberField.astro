---
import { Icon } from "astro-icon/components";
import { clamp, formatMSS } from "../scripts/utils.js";

interface Props {
  label: string;
  name: string;
  value: number;
  min: number;
  max: number;
  step: number;
  /** When true, show and edit as M:SS with digit-shift entry. */
  duration?: boolean;
}

const { label, name, value, min, max, step, duration = false } = Astro.props;
const clamped = clamp(value, min, max);
const inputValue = duration ? formatMSS(clamped) : String(clamped);
const inputId = `number-field-${name}`;
const roleDescription = duration ? "Duration" : "Number field";
---

<div
  class="number-field"
  data-number-field
  data-name={name}
  data-min={min}
  data-max={max}
  data-step={step}
  data-duration={duration ? "true" : "false"}
>
  <label class="label" for={inputId}>
    <div class="wrapper">
      <button type="button" class="decrement" aria-label={`Decrease ${label}`} tabindex="-1">
        <Icon name="minus" aria-hidden="true" />
      </button>
      <div class="input-wrapper">
        <input
          id={inputId}
          class="input"
          type="text"
          name={name}
          value={inputValue}
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          aria-roledescription={roleDescription}
        />
      </div>
      <button type="button" class="increment" aria-label={`Increase ${label}`} tabindex="-1">
        <Icon name="plus" aria-hidden="true" />
      </button>
    </div>
    <span class="text">{label}</span>
  </label>
</div>

<style>
  .number-field {
    text-align: center;
    display: grid;
    justify-content: center;
    font-size: clamp(1.65rem, 1.2em, 2em);

    &:focus-within button {
      opacity: 1;
      pointer-events: auto;
    }
  }

  label {
    grid-row: 2;
    grid-column: 1 / -1;
    padding-block-end: 0.25em;
    margin-block-start: -0.25em;
  }

  .text {
    display: block;
    font-size: 0.6em;
    line-height: 1;
  }

  .wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid transparent;
    border-radius: calc(infinity * 1px);
    isolation: isolate;
  }

  input {
    all: unset;
    width: 4ch;
    font: inherit;
    font-size: 1.1em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-align: center;
    background: transparent;
    color: inherit;
    cursor: pointer;
    caret-color: transparent;
    border-radius: 0.25em;
    padding-inline: 0.05em;

    &:focus {
      background-color: var(--color-fg-subtle);
    }

    &::selection {
      background-color: transparent;
    }
  }

  button {
    all: unset;
    display: flex;
    outline: revert;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    padding: 0.25rem 0.5rem;
    opacity: 0;
    font-size: 0.9em;
    z-index: 1;
    pointer-events: none;

    &:active {
      transform: translateY(1px);
    }

    :global([data-icon]) {
      flex: none;
      width: 1em;
      height: 1em;
      min-width: 1em;
    }

    &:not(:disabled) {
      cursor: pointer;
    }
  }

  .decrement {
    right: 100%;
  }

  .increment {
    left: 100%;
  }
</style>
