---
import { formatMSS } from "../scripts/format.js";

interface Props {
  label: string;
  name: string;
  value: number;
  min: number;
  max: number;
  step: number;
  /** When true, show and edit as M:SS with digit-shift entry. */
  duration?: boolean;
}

const { label, name, value, min, max, step, duration = false } = Astro.props;
const clamped = Math.min(max, Math.max(min, value));
const inputValue = duration ? formatMSS(clamped) : String(clamped);
const inputId = `number-field-${name}`;
const roleDescription = duration ? "Duration" : "Number field";
---

<div
  class="number-field"
  data-number-field
  data-name={name}
  data-min={min}
  data-max={max}
  data-step={step}
  data-duration={duration ? "true" : "false"}
>
  <div class="wrapper">
    <button type="button" class="decrement" aria-label={`Decrease ${label}`} tabindex="-1">
      −
    </button>
    <input
      id={inputId}
      class="input"
      type="text"
      name={name}
      value={inputValue}
      inputmode="numeric"
      autocomplete="off"
      spellcheck="false"
      aria-roledescription={roleDescription}
    />
    <button type="button" class="increment" aria-label={`Increase ${label}`} tabindex="-1">
      +
    </button>
  </div>
  <label class="label" for={inputId}>{label}</label>
</div>

<style>
  .number-field {
    text-align: center;
    inline-size: 100%;
    display: grid;
    justify-content: center;
    gap: 0.5rem;
    scroll-margin-block: 25vh;
  }

  .wrapper {
    display: grid;
    grid-template-columns: 1fr 4ch 1fr;
    border: 1px solid transparent;
    border-radius: calc(infinity * 1px);
  }

  input {
    all: unset;
    outline: revert;
    width: 4ch;
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-align: center;
    background: transparent;
    outline: none;
    caret-color: transparent;

    &::selection {
      background-color: oklch(92.9% 0.013 255.508);
    }
  }

  label {
    grid-row: 2;
    grid-column: 1 / -1;
  }

  button {
    all: unset;
    outline: revert;
    padding: 0.75rem 1rem;
    cursor: pointer;
    opacity: 0;
    touch-action: manipulation;
  }

  .wrapper:not([data-disabled]):focus-within {
    background-color: oklch(98.4% 0.003 247.858);
    border-color: oklch(92.9% 0.013 255.508);

    button {
      opacity: 1;
    }
  }

  [data-disabled] {
    opacity: 0.5;
  }

  @media (hover: hover) {
    .wrapper:not([data-disabled]):hover button {
      opacity: 1;
    }
    .wrapper:not([data-disabled]):hover {
      background-color: oklch(98.4% 0.003 247.858);
      border-color: oklch(92.9% 0.013 255.508);
    }
  }
</style>
