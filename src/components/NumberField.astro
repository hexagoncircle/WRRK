---
import { formatMSS } from "../scripts/format.js";
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  name: string;
  value: number;
  min: number;
  max: number;
  step: number;
  /** When true, show and edit as M:SS with digit-shift entry. */
  duration?: boolean;
}

const { label, name, value, min, max, step, duration = false } = Astro.props;
const clamped = Math.min(max, Math.max(min, value));
const inputValue = duration ? formatMSS(clamped) : String(clamped);
const inputId = `number-field-${name}`;
const roleDescription = duration ? "Duration" : "Number field";
---

<div
  class="number-field"
  data-number-field
  data-name={name}
  data-min={min}
  data-max={max}
  data-step={step}
  data-duration={duration ? "true" : "false"}
>
  <label class="label" for={inputId}>
    <div class="wrapper">
      <button type="button" class="decrement" aria-label={`Decrease ${label}`} tabindex="-1">
        <Icon name="minus" aria-hidden="true" />
      </button>
      <input
        id={inputId}
        class="input"
        type="text"
        name={name}
        value={inputValue}
        inputmode="numeric"
        autocomplete="off"
        spellcheck="false"
        aria-roledescription={roleDescription}
      />
      <button type="button" class="increment" aria-label={`Increase ${label}`} tabindex="-1">
        <Icon name="plus" aria-hidden="true" />
      </button>
    </div>
    <span class="text">{label}</span>
  </label>
</div>

<style>
  .number-field {
    text-align: center;
    display: grid;
    justify-content: center;
    scroll-margin-block: 25vh;
    font-size: clamp(1.65rem, 5vmin, 2rem);

    &:hover {
      z-index: 1;
    }
  }

  label {
    grid-row: 2;
    grid-column: 1 / -1;
    padding-block-end: 0.25rem;
    margin-block-start: -0.25rem;
    transition: color 200ms ease-out;
  }

  .text {
    display: block;
    font-size: 0.6em;
    line-height: 1;
  }

  .wrapper {
    position: relative;
    display: grid;
    border: 1px solid transparent;
    border-radius: calc(infinity * 1px);
  }

  input {
    all: unset;
    outline: revert;
    width: 4ch;
    padding: 0;
    font: inherit;
    font-size: 1.1em;
    font-variant-numeric: tabular-nums;
    text-align: center;
    background: transparent;
    outline: none;
    color: inherit;
    cursor: pointer;
    caret-color: transparent;

    &::selection {
      background-color: transparent;
    }
  }

  button {
    all: unset;
    display: flex;
    outline: revert;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    padding: 0.25rem 0.5rem;
    opacity: 0;
    font-size: 0.9em;
    scale: 0.9;
    touch-action: manipulation;
    transition: 150ms ease-out;
    transition-property: opacity, scale;

    :global(svg) {
      flex-shrink: 0;
    }

    &:not(:disabled) {
      cursor: pointer;
    }
  }

  .decrement {
    right: 100%;
  }

  .increment {
    left: 100%;
  }
</style>
