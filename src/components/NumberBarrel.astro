---
interface Props {
  min?: number;
  max?: number;
  value?: number;
  name?: string;
  label?: string;
}

const { min = 0, max = 60, value = 0, name, label = "Number" } = Astro.props;

const clamped = Math.min(max, Math.max(min, value));
const pad = (n: number) => String(n).padStart(2, "0");
const numbers = Array.from({ length: max - min + 1 }, (_, i) => min + i);
---

<div class="barrel" data-number-barrel data-min={min} data-max={max} data-value={clamped}>
  <div
    class="barrel__viewport"
    data-barrel-viewport
    tabindex="0"
    role="spinbutton"
    aria-label={label}
    aria-valuemin={min}
    aria-valuemax={max}
    aria-valuenow={clamped}
    aria-valuetext={pad(clamped)}
  >
    {
      numbers.map((n) => (
        <span class="barrel__item" data-barrel-item aria-hidden="true">
          {pad(n)}
        </span>
      ))
    }
  </div>
  <input type="hidden" name={name} value={pad(clamped)} data-barrel-input />
</div>

<style>
  .barrel {
    --barrel-item-height: 2.5rem;
    --barrel-visible: 1;
    width: 2ch;
  }

  .barrel__viewport {
    position: relative;
    height: calc(var(--barrel-item-height) * var(--barrel-visible));
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    user-select: none;
  }

  .barrel__viewport:active {
    cursor: grabbing;
  }

  .barrel__viewport:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .barrel__item {
    position: absolute;
    inset: 0;
    height: var(--barrel-item-height);
    display: grid;
    place-content: center;
    font-weight: bold;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
</style>

<script>
  import { animate } from "motion";

  /** Momentum decay time constant, in seconds. Larger = longer coast. */
  const FLING_TAU = 0.325;
  /** Items a single fling may travel. */
  const FLING_MAX_ITEMS = 40;
  /** Below this speed (items/sec) a release just snaps to the nearest item. */
  const FLING_MIN_VELOCITY = 1.5;
  /** Coast ends and snapping begins once speed drops below this (items/sec). */
  const FLING_STOP_VELOCITY = 1;

  function enhanceBarrel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>("[data-barrel-viewport]");
    const input = root.querySelector<HTMLInputElement>("[data-barrel-input]");
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-barrel-item]"));

    if (!viewport) return;
    if (items.length === 0) return;

    const min = Number(root.dataset.min ?? 0);
    const count = items.length;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const pad = (n: number) => String(n).padStart(2, "0");
    const mod = (n: number, m: number) => ((n % m) + m) % m;

    let itemHeight = 1;
    let total = count;
    let center = 0;

    /** Fractional item index. Unbounded; wrapped only at render time. */
    let position = Number(root.dataset.value ?? min) - min;
    let activeIndex = mod(Math.round(position), count);
    let animation: { stop: () => void } | null = null;
    let inertiaFrame = 0;
    const renderedY: number[] = new Array(count).fill(NaN);

    const measure = () => {
      itemHeight = items[0].offsetHeight || 1;
      total = itemHeight * count;
      const visible = Math.max(1, Math.round(viewport.clientHeight / itemHeight));
      center = Math.floor(visible / 2);
      renderedY.fill(NaN);
    };

    const commitValue = () => {
      const index = mod(Math.round(position), count);
      if (index === activeIndex) return;
      activeIndex = index;

      const value = min + index;
      root.dataset.value = String(value);
      if (input) input.value = pad(value);
      viewport.setAttribute("aria-valuenow", String(value));
      viewport.setAttribute("aria-valuetext", pad(value));

      root.dispatchEvent(new CustomEvent("barrel-change", { detail: { value }, bubbles: true }));
    };

    const render = () => {
      for (let i = 0; i < count; i++) {
        const y = mod((i - position) * itemHeight + (center + 1) * itemHeight, total) - itemHeight;
        if (renderedY[i] !== y) {
          renderedY[i] = y;
          items[i].style.transform = `translateY(${y}px)`;
        }
      }
      commitValue();
    };

    const stopAnimation = () => {
      animation?.stop();
      animation = null;
      if (inertiaFrame) {
        cancelAnimationFrame(inertiaFrame);
        inertiaFrame = 0;
      }
    };

    /** Spring the wheel to a whole item, carrying gesture velocity through. */
    const animateTo = (target: number, velocity = 0) => {
      stopAnimation();

      if (reduceMotion.matches) {
        position = target;
        render();
        return;
      }

      animation = animate(position, target, {
        type: "spring",
        velocity,
        stiffness: 220,
        damping: 26,
        restDelta: 0.002,
        onUpdate: (latest: number) => {
          position = latest;
          render();
        },
      });
    };

    /** Coast with exponential friction, then spring-snap to the nearest item. */
    const settle = (velocity: number) => {
      stopAnimation();

      if (reduceMotion.matches || Math.abs(velocity) < FLING_MIN_VELOCITY) {
        animateTo(Math.round(position), velocity);
        return;
      }

      // Cap coast distance (v * tau is the analytic decay distance).
      let v = velocity;
      if (Math.abs(v) * FLING_TAU > FLING_MAX_ITEMS) {
        v = Math.sign(v) * (FLING_MAX_ITEMS / FLING_TAU);
      }

      let last = performance.now();
      const tick = (now: number) => {
        const dt = (now - last) / 1000;
        last = now;

        position += v * dt;
        v *= Math.exp(-dt / FLING_TAU);
        render();

        if (Math.abs(v) > FLING_STOP_VELOCITY) {
          inertiaFrame = requestAnimationFrame(tick);
        } else {
          inertiaFrame = 0;
          animateTo(Math.round(position), v);
        }
      };
      inertiaFrame = requestAnimationFrame(tick);
    };

    let dragging = false;
    let activePointer: number | null = null;
    let dragStartY = 0;
    let dragStartPosition = 0;
    /** Recent pointer samples for release-velocity (desktop fires many 0-delta moves). */
    let samples: { y: number; t: number }[] = [];

    const releaseVelocity = (timeStamp: number) => {
      // Drop trailing stillness so a pause before mouseup doesn't kill the fling.
      while (samples.length > 1 && timeStamp - samples[samples.length - 1].t > 100) {
        samples.pop();
      }
      if (samples.length < 2) return 0;

      const newest = samples[samples.length - 1];
      if (timeStamp - newest.t > 100) return 0;

      const cutoff = newest.t - 100;
      let oldest = samples[0];
      for (const sample of samples) {
        if (sample.t >= cutoff) {
          oldest = sample;
          break;
        }
      }

      const elapsed = (newest.t - oldest.t) / 1000;
      if (elapsed <= 0) return 0;
      return -(newest.y - oldest.y) / itemHeight / elapsed;
    };

    viewport.addEventListener("pointerdown", (event) => {
      stopAnimation();
      dragging = true;
      activePointer = event.pointerId;
      viewport.setPointerCapture(event.pointerId);

      dragStartY = event.clientY;
      dragStartPosition = position;
      samples = [{ y: event.clientY, t: event.timeStamp }];
    });

    viewport.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerId !== activePointer) return;

      // No button held means the press already ended (a plain hover/coast move
      // on desktop). Finish the drag instead of dragging the wheel to the
      // cursor, which would freeze the fling animation.
      if (event.buttons === 0) {
        endDrag(event);
        return;
      }

      // Numbers follow the pointer, so dragging down lowers the value.
      position = dragStartPosition - (event.clientY - dragStartY) / itemHeight;
      render();

      const prev = samples[samples.length - 1];
      // Ignore 0-delta moves — common on desktop with pointer capture; they
      // were wiping fling velocity before pointerup.
      if (!prev || event.clientY === prev.y) return;

      samples.push({ y: event.clientY, t: event.timeStamp });
      const cutoff = event.timeStamp - 120;
      while (samples.length > 2 && samples[0].t < cutoff) samples.shift();
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== activePointer) return;
      dragging = false;
      activePointer = null;
      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }

      settle(releaseVelocity(event.timeStamp));
    };

    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    viewport.addEventListener("lostpointercapture", endDrag);

    let wheelTimer = 0;
    viewport.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        stopAnimation();

        let delta = event.deltaY;
        if (event.deltaMode === 1) delta *= 16;
        else if (event.deltaMode === 2) delta *= viewport.clientHeight;

        position += delta / itemHeight;
        render();

        window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => animateTo(Math.round(position)), 120);
      },
      { passive: false },
    );

    viewport.addEventListener("keydown", (event) => {
      let delta = 0;
      if (event.key === "ArrowUp") delta = -1;
      else if (event.key === "ArrowDown") delta = 1;
      else if (event.key === "PageUp") delta = -5;
      else if (event.key === "PageDown") delta = 5;
      if (delta === 0) return;

      event.preventDefault();
      animateTo(Math.round(position) + delta);
    });

    measure();
    render();

    new ResizeObserver(() => {
      measure();
      render();
    }).observe(viewport);
  }

  function init() {
    for (const root of document.querySelectorAll("[data-number-barrel]")) {
      if (root instanceof HTMLElement) enhanceBarrel(root);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>
