---
import TimeDisplay from "./TimeDisplay.astro";
import CounterRing from "./CounterRing.astro";
import ProgressRing from "./ProgressRing.astro";
import PhaseLabel from "./PhaseLabel.astro";
import { Icon } from "astro-icon/components";
import { formatMSS } from "../scripts/utils.js";
import { DEFAULT_CONFIG, totalWorkoutSeconds } from "../scripts/model.js";

const { class: className, ...rest } = Astro.props;
const totalTime = formatMSS(totalWorkoutSeconds(DEFAULT_CONFIG));
---

<timer-player class:list={["timer-player", className]} {...rest}>
  <TimeDisplay />
  <div class="status">
    <div class="round" aria-live="polite">
      <span class="round-label" hidden>Round</span>
      <Icon name="clock" aria-hidden="true" />
      <output class="round-current">{totalTime}</output>
    </div>
    <div class="controls">
      <button type="button" class="btn reset">
        <Icon name="reset" aria-hidden="true" />
        <span class="label">Reset</span>
      </button>
      <button type="button" class="btn playback" data-action="play">
        <Icon name="pause" aria-hidden="true" />
        <Icon name="play" aria-hidden="true" />
        <span class="label sr-only">Start</span>
      </button>
    </div>
    <PhaseLabel />
  </div>
  <div class="rings" aria-hidden="true">
    <CounterRing count={DEFAULT_CONFIG.rounds} />
    <ProgressRing work={DEFAULT_CONFIG.workSeconds} rest={DEFAULT_CONFIG.restSeconds} />
  </div>
</timer-player>

<script>
  import { enhancePlayer } from "../scripts/player.js";

  /**
   * Light-DOM timer player shell. Markup comes from Astro; enhance() wires the engine.
   */
  class TimerPlayerElement extends HTMLElement {
    /**
     * @param {{
     *   getConfig: () => import('../scripts/model.js').TimerConfig,
     *   attrsRoot?: HTMLElement,
     *   onRunningChange?: (running: boolean) => void,
     * }} options
     */
    async enhance(options: {
      getConfig: () => import("../scripts/model.js").TimerConfig;
      attrsRoot?: HTMLElement;
      onRunningChange?: (running: boolean) => void;
    }) {
      await Promise.all([
        customElements.whenDefined("time-display"),
        customElements.whenDefined("phase-label"),
        customElements.whenDefined("counter-ring"),
        customElements.whenDefined("progress-ring"),
      ]);
      return enhancePlayer(this, options);
    }
  }

  if (!customElements.get("timer-player")) {
    customElements.define("timer-player", TimerPlayerElement);
  }
</script>

<style>
  .timer-player {
    position: relative;
    display: grid;
    grid-template-areas:
      "status"
      "time"
      "rings";
    column-gap: inherit;
    row-gap: inherit;
    justify-content: center;
    min-width: 0;
    margin: auto;
    isolation: isolate;
    user-select: none;
    transform: translateZ(0);
  }

  .status {
    grid-area: status;
    display: flex;
    gap: 0.2em;
    align-items: center;
    inline-size: 100%;
    font-size: 1.6em;
    line-height: 1;
    font-family: var(--font-display);
  }

  .rings {
    grid-area: rings;
    display: flex;
    justify-content: space-between;
    margin-inline: -0.7em;
  }

  .round {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  [data-icon] {
    width: var(--size, 1em);
    height: var(--size, 1em);
  }

  [data-icon="clock"],
  [data-icon="reset"] {
    --size: 0.9em;
    translate: 0 0.02em;
  }

  [data-icon="play"] {
    --size: 0.8em;
    translate: -0.025em;
  }

  :global([data-status]:not([data-status="idle"])) :global([data-icon="clock"]) {
    display: none;
  }

  .controls {
    display: flex;
    align-items: center;
    margin-inline-start: auto;
    block-size: 1lh;
  }

  .controls button {
    margin-inline-start: calc(var(--btn-padding) * -1);
    margin-block: calc(var(--btn-padding) * -1);
  }

  .playback {
    position: static;
    cursor: pointer;
    opacity: 0;
    margin-inline-end: -0.025em;
    inline-size: 1lh;
    block-size: 1lh;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
    }

    &:focus-visible {
      opacity: 1;
    }
  }

  .reset {
    position: relative;
    z-index: 1;
    display: none;
  }

  :global([data-status="idle"]) .playback {
    opacity: 1;
  }

  :global([data-status="preparing"]),
  :global([data-status="countdown"]) {
    .timer-player {
      cursor: wait;
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="paused"]) {
    .round {
      display: none;
    }

    .controls {
      flex: 1;
      justify-content: space-between;
      align-items: center;
    }

    .playback {
      opacity: 1;
    }

    .reset {
      display: inline-flex;
    }
  }

  .playback[data-action="play"] :global([data-icon="pause"]),
  .playback[data-action="pause"] :global([data-icon="play"]) {
    display: none;
  }

  @media (min-aspect-ratio: 3/2) {
    .timer-player {
      grid-template-areas:
        "time rings"
        "status rings";
    }

    .rings {
      flex-direction: column;
    }
  }
</style>
