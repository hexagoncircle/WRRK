---
import Digit from "./Digit.astro";
import { Icon } from "astro-icon/components";

const { class: className, ...rest } = Astro.props;
---

<article class:list={["timer-player", className]} data-player data-status="idle" {...rest}>
  <time class="time" datetime="PT0M0S">
    <Digit digit={0} />
    <span class="time-separator"></span>
    <Digit digit={0} />
    <Digit digit={0} />
  </time>
  <div class="status" aria-live="polite">
    <p class="round">
      Round
      <output class="round-output" aria-label="0 of 0">
        <span class="round-current">0</span>
        <span>/</span>
        <span class="round-total">0</span>
      </output>
    </p>
    <div class="controls">
      <button type="button" class="reset">
        <Icon name="reset" aria-hidden="true" />
        <span class="label sr-only">Reset</span>
      </button>
      <button type="button" class="playback" data-action="play">
        <Icon name="play" aria-hidden="true" />
        <Icon name="pause" aria-hidden="true" />
        <span class="label sr-only">Start</span>
      </button>
    </div>
    <p class="phase">Loading</p>
  </div>
</article>

<style>
  .timer-player {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    justify-content: center;
    font-size: clamp(1rem, 5vmin, 2rem);
    min-width: 0;
    margin: auto;
  }

  .status {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
    font-family: var(--font-display);
  }

  .time {
    display: flex;
    gap: 5vmin;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
    inline-size: 70vmin;
  }

  .time-separator {
    --size: 3vmin;
    display: flex;
    align-self: center;
    flex-direction: column;
    row-gap: calc(var(--size) * 2.5);

    &::before,
    &::after {
      content: "";
      display: block;
      width: var(--size);
      height: var(--size);
      background-color: currentColor;
      border-radius: 50%;
    }
  }

  .round {
    display: flex;
    gap: 0.2rem;
  }

  .round-output {
    display: flex;
    gap: 0.1rem;
    font-variant-numeric: tabular-nums;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8em;
  }

  .controls button {
    all: unset;
    cursor: pointer;
    outline: revert;
    padding: 0.5rem;
  }

  .controls [data-icon] {
    --size: 1.5em;
    width: var(--size);
    height: var(--size);
  }

  .playback[data-action="play"] :global([data-icon="pause"]),
  .playback[data-action="pause"] :global([data-icon="play"]) {
    display: none;
  }

  [data-status="idle"] .reset {
    display: none;
  }

  [data-status="paused"] .time {
    animation: pulse 1s steps(1, jump-start) infinite;
  }

  @keyframes pulse {
    from,
    to {
      opacity: 0.5;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (height < 30rem) {
    .timer-player {
      flex-direction: column;
    }
  }
</style>
