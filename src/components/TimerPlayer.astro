---
import Digit from "./Digit.astro";
import CounterRing from "./CounterRing.astro";
import ProgressRing from "./ProgressRing.astro";
import { Icon } from "astro-icon/components";
import { formatMSS } from "../scripts/format.js";
import { DEFAULT_CONFIG, totalWorkoutSeconds } from "../scripts/model.js";

const { class: className, ...rest } = Astro.props;
const totalTime = formatMSS(totalWorkoutSeconds(DEFAULT_CONFIG));
---

<article class:list={["timer-player", className]} data-player {...rest}>
  <time class="time" datetime="PT0M0S" aria-label="0:00">
    <Digit digit={0} />
    <span class="time-separator"></span>
    <Digit digit={0} />
    <Digit digit={0} />
  </time>
  <div class="status" aria-live="polite">
    <div class="round">
      <span class="round-label" hidden>Round</span>
      <Icon name="clock" aria-hidden="true" />
      <output class="round-current">{totalTime}</output>
    </div>
    <div class="controls">
      <button type="button" class="btn reset">
        <Icon name="reset" aria-hidden="true" />
        <span class="label sr-only">Reset</span>
      </button>
      <button type="button" class="btn playback" data-action="play">
        <Icon name="pause" aria-hidden="true" />
        <Icon name="play" aria-hidden="true" />
        <span class="label sr-only">Start</span>
      </button>
    </div>
    <div class="phase" aria-label="Start">
      <div class="phase-track" aria-hidden="true">
        <div class="phase-label">Start</div>
      </div>
    </div>
  </div>
  <div class="rings" aria-hidden="true">
    <CounterRing count={DEFAULT_CONFIG.rounds} />
    <ProgressRing work={DEFAULT_CONFIG.workSeconds} rest={DEFAULT_CONFIG.restSeconds} />
  </div>
</article>

<style>
  .timer-player {
    position: relative;
    display: grid;
    grid-template-areas:
      "status"
      "time"
      "rings";
    column-gap: 3em;
    row-gap: inherit;
    justify-content: center;
    min-width: 0;
    margin: auto;
    isolation: isolate;
    user-select: none;
  }

  .status {
    grid-area: status;
    display: flex;
    gap: 0.2em;
    align-items: center;
    inline-size: 100%;
    font-size: 1.4em;
    line-height: 1;
    font-family: var(--font-display);
  }

  .time {
    grid-area: time;
    display: flex;
    gap: 1em;
    inline-size: 15em;
    font-variant-numeric: tabular-nums;
    transition: opacity 300ms ease-out;
  }

  .rings {
    grid-area: rings;
    display: flex;
    justify-content: space-between;
    margin-inline: -0.4em;
  }

  .time-separator {
    --size: 0.6em;
    display: flex;
    align-self: center;
    flex-direction: column;
    row-gap: calc(var(--size) * 2.5);

    &::before,
    &::after {
      content: "";
      display: block;
      width: var(--size);
      height: var(--size);
      background-color: var(--color-digit, var(--color-fg));
      border-radius: 50%;
      transition: background-color 1s steps(1, jump-start);
    }
  }

  .round {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  [data-icon="clock"] {
    --size: 0.8em;
    width: var(--size);
    height: var(--size);
  }

  :global([data-status]:not([data-status="idle"])) :global([data-icon="clock"]) {
    display: none;
  }

  .controls {
    display: flex;
    align-items: start;
    font-size: 0.8em;
    margin-inline-start: auto;
  }

  .controls [data-icon] {
    --size: 0.9em;
    width: var(--size);
    height: var(--size);
  }

  .playback {
    position: static;
    cursor: pointer;
    opacity: 0;

    [data-icon="play"] {
      translate: -0.05em;
    }

    &::before {
      content: "";
      position: absolute;
      inset: 0;
    }

    &:focus-visible {
      opacity: 1;
    }
  }

  .reset {
    position: relative;
    z-index: 1;
    display: none;
  }

  :global([data-status="idle"]) .playback {
    opacity: 1;
  }

  :global([data-status="preparing"]) {
    .timer-player {
      cursor: wait;
    }

    .time-separator {
      --color-digit: var(--color-fg-subtle);
    }

    .phase {
      animation: pulse 1s steps(1, jump-start) 3;
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="countdown"]) {
    .timer-player {
      cursor: wait;
    }

    .time-separator {
      --color-digit: var(--color-fg-subtle);

      &::before {
        transition-delay: 2s;
      }
      &::after {
        transition-delay: 1s;
      }
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="paused"]) {
    .time {
      opacity: 0.25;
    }

    .time-separator,
    :global(.digit path) {
      animation: pulse 1s steps(1, jump-start) infinite;
    }

    .playback {
      opacity: 1;
    }

    .reset {
      display: block;
    }
  }

  :global([data-status="complete"]) {
    .time-separator,
    :global(.digit path),
    :global(.phase-label),
    .rings {
      animation: pulse 1s steps(1, jump-start) 3 forwards;
    }
  }

  .playback[data-action="play"] :global([data-icon="pause"]),
  .playback[data-action="pause"] :global([data-icon="play"]) {
    display: none;
  }

  .phase {
    overflow: hidden;
    line-height: 1;
    block-size: 1lh;
    text-align: end;
    pointer-events: none;
  }

  .phase :global(.phase-track) {
    display: flex;
    flex-direction: column;
    align-items: end;
    will-change: transform;
  }

  .phase :global(.phase-label) {
    display: block;
    flex: 0 0 1.2em;
    block-size: 1lh;
    line-height: 1;
    white-space: nowrap;
    text-align: end;
    color: var(--color-digit, var(--color-fg));
  }

  .phase[data-tone="work"],
  .phase :global(.phase-label[data-tone="work"]) {
    color: var(--color-work);
  }

  .phase[data-tone="rest"],
  .phase :global(.phase-label[data-tone="rest"]) {
    color: var(--color-rest);
  }

  @media (min-aspect-ratio: 920/600) {
    .timer-player {
      grid-template-areas:
        "time rings"
        "status rings";
    }

    .rings {
      flex-direction: column;
    }
  }
</style>
