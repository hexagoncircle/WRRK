---
const { class: className, ...rest } = Astro.props;
---

<article class:list={["timer-player", className]} data-player data-status="idle" {...rest}>
  <p class="time">0:00</p>
  <div class="status">
    <p class="round">Round <span>0</span>/<span>0</span></p>
    <p class="phase">Loading</p>
  </div>

  <div class="controls">
    <button type="button" class="play-pause">Start</button>
    <button type="button" class="reset">Reset</button>
  </div>
</article>

<style>
  .timer-player {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .status {
    display: flex;
    gap: 2rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .time {
    font-size: clamp(5rem, 30vmin, 10rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    min-height: 1lh;
  }

  .round {
    font-variant-numeric: tabular-nums;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  [data-status="idle"] .time {
    opacity: 0.2;
  }
</style>
