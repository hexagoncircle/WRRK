---
import TimeDisplay from "./TimeDisplay.astro";
import CounterRing from "./CounterRing.astro";
import ProgressRing from "./ProgressRing.astro";
import PhaseLabel from "./PhaseLabel.astro";
import { Icon } from "astro-icon/components";
import { formatMSS } from "../scripts/utils.js";
import { DEFAULT_CONFIG, totalWorkoutSeconds } from "../scripts/model.js";

const { class: className, ...rest } = Astro.props;
const totalTime = formatMSS(totalWorkoutSeconds(DEFAULT_CONFIG));
---

<article class:list={["timer-player", className]} data-player {...rest}>
  <TimeDisplay />
  <div class="status" aria-live="polite">
    <div class="round">
      <span class="round-label" hidden>Round</span>
      <Icon name="clock" aria-hidden="true" />
      <output class="round-current">{totalTime}</output>
    </div>
    <div class="controls">
      <button type="button" class="btn reset">
        <Icon name="reset" aria-hidden="true" />
        <span class="label sr-only">Reset</span>
      </button>
      <button type="button" class="btn playback" data-action="play">
        <Icon name="pause" aria-hidden="true" />
        <Icon name="play" aria-hidden="true" />
        <span class="label sr-only">Start</span>
      </button>
    </div>
    <PhaseLabel />
  </div>
  <div class="rings" aria-hidden="true">
    <CounterRing count={DEFAULT_CONFIG.rounds} />
    <ProgressRing work={DEFAULT_CONFIG.workSeconds} rest={DEFAULT_CONFIG.restSeconds} />
  </div>
</article>

<style>
  .timer-player {
    position: relative;
    display: grid;
    grid-template-areas:
      "status"
      "time"
      "rings";
    column-gap: 3em;
    row-gap: inherit;
    justify-content: center;
    min-width: 0;
    margin: auto;
    isolation: isolate;
    user-select: none;
  }

  .status {
    grid-area: status;
    display: flex;
    gap: 0.2em;
    align-items: center;
    inline-size: 100%;
    font-size: 1.4em;
    line-height: 1;
    font-family: var(--font-display);
  }

  .rings {
    grid-area: rings;
    display: flex;
    justify-content: space-between;
    margin-inline: -0.4em;
  }

  .round {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  [data-icon="clock"] {
    --size: 0.8em;
    width: var(--size);
    height: var(--size);
  }

  :global([data-status]:not([data-status="idle"])) :global([data-icon="clock"]) {
    display: none;
  }

  .controls {
    display: flex;
    align-items: start;
    font-size: 0.8em;
    margin-inline-start: auto;
  }

  .controls [data-icon] {
    --size: 0.9em;
    width: var(--size);
    height: var(--size);
  }

  .playback {
    position: static;
    cursor: pointer;
    opacity: 0;

    [data-icon="play"] {
      translate: -0.05em;
    }

    &::before {
      content: "";
      position: absolute;
      inset: 0;
    }

    &:focus-visible {
      opacity: 1;
    }
  }

  .reset {
    position: relative;
    z-index: 1;
    display: none;
  }

  :global([data-status="idle"]) .playback {
    opacity: 1;
  }

  :global([data-status="preparing"]) {
    .timer-player {
      cursor: wait;
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="countdown"]) {
    .timer-player {
      cursor: wait;
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="paused"]) {
    .playback {
      opacity: 1;
    }

    .reset {
      display: block;
    }
  }

  :global([data-status="complete"]) .rings {
    animation: pulse 1s steps(1, jump-start) 3 forwards;
  }

  .playback[data-action="play"] :global([data-icon="pause"]),
  .playback[data-action="pause"] :global([data-icon="play"]) {
    display: none;
  }

  @media (min-aspect-ratio: 920/600) {
    .timer-player {
      grid-template-areas:
        "time rings"
        "status rings";
    }

    .rings {
      flex-direction: column;
    }
  }
</style>
