---
import Digit from "./Digit.astro";
import CounterRing from "./CounterRing.astro";
import ProgressRing from "./ProgressRing.astro";
import { Icon } from "astro-icon/components";
import { DEFAULT_CONFIG } from "../scripts/model.js";

const { class: className, ...rest } = Astro.props;
---

<article class:list={["timer-player", className]} data-player {...rest}>
  <time class="time" datetime="PT0M0S" aria-label="0:00">
    <Digit digit={0} />
    <span class="time-separator"></span>
    <Digit digit={0} />
    <Digit digit={0} />
  </time>
  <div class="status" aria-live="polite">
    <div class="round">
      <span class="round-label" hidden>Round</span>
      <output class="round-current">––</output>
    </div>
    <div class="controls">
      <button type="button" class="reset">
        <Icon name="reset" aria-hidden="true" />
        <span class="label sr-only">Reset</span>
      </button>
      <button type="button" class="playback" data-action="play">
        <Icon name="pause" aria-hidden="true" />
        <Icon name="play" aria-hidden="true" />
        <span class="label sr-only">Start</span>
      </button>
    </div>
    <div class="phase" aria-label="Start">
      <div class="phase-track" aria-hidden="true">
        <div class="phase-label">Start</div>
      </div>
    </div>
  </div>
  <div class="rings" aria-hidden="true">
    <CounterRing count={DEFAULT_CONFIG.rounds} />
    <ProgressRing work={DEFAULT_CONFIG.workSeconds} rest={DEFAULT_CONFIG.restSeconds} />
  </div>
</article>

<style>
  .timer-player {
    position: relative;
    display: grid;
    grid-template-areas:
      "status"
      "time"
      "rings";
    grid-template-rows: auto 1fr auto;
    column-gap: 15vmin;
    row-gap: 5vmin;
    justify-content: center;
    font-size: 7vmin;
    min-width: 0;
    margin: auto;
    isolation: isolate;
    user-select: none;
  }

  .status {
    grid-area: status;
    display: flex;
    gap: 2vmin;
    align-items: center;
    inline-size: 100%;
    font-family: var(--font-display);
  }

  .time {
    grid-area: time;
    display: flex;
    gap: 5vmin;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
    inline-size: 75vmin;
    transition: opacity 300ms ease-out;
  }

  .rings {
    grid-area: rings;
    display: flex;
    justify-content: space-between;
  }

  .time-separator {
    --size: 3vmin;
    display: flex;
    align-self: center;
    flex-direction: column;
    row-gap: calc(var(--size) * 2.5);

    &::before,
    &::after {
      content: "";
      display: block;
      width: var(--size);
      height: var(--size);
      background-color: var(--color-digit, var(--color-fg));
      border-radius: 50%;
      transition: background-color 1s steps(1, jump-start);
    }
  }

  .round {
    display: flex;
    gap: 2vmin;
  }

  .controls {
    display: flex;
    gap: 1vmin;
    align-items: start;
    font-size: 0.8em;
    margin-inline-start: auto;
  }

  .controls :where(button) {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
    padding: 1vmin;
    border-radius: 50%;
    outline-offset: 6px;
    transition: outline-offset 200ms ease-out;

    &:focus-visible {
      outline: 4px solid var(--color-ring);
      outline-offset: 1px;
    }
  }

  .controls [data-icon] {
    --size: 0.8em;
    width: var(--size);
    height: var(--size);
  }

  /* position: static so ::before can cover the positioned .timer-player */
  .playback {
    position: static;
    cursor: pointer;
    opacity: 0;

    &::before {
      content: "";
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    &:focus-visible {
      opacity: 1;
    }
  }

  .reset {
    position: relative;
    z-index: 1;
    display: none;
  }

  :global([data-status="idle"]) .playback {
    opacity: 1;
  }

  :global([data-status="preparing"]) {
    .timer-player {
      cursor: wait;
    }

    .time-separator {
      --color-digit: var(--color-fg-subtle);

      &::before {
        transition-delay: 2s;
      }
      &::after {
        transition-delay: 1s;
      }
    }

    .playback:disabled {
      cursor: default;
      pointer-events: none;
    }
  }

  :global([data-status="paused"]) {
    .time {
      opacity: 0.25;
    }

    .time-separator,
    :global(.digit path) {
      animation: pulse 1s steps(1, jump-start) infinite;
    }

    .playback {
      opacity: 1;
    }

    .reset {
      display: block;
    }
  }

  :global([data-status="complete"]) {
    .time-separator,
    :global(.digit path),
    :global(.phase-label),
    .rings {
      animation: pulse 1s steps(1, jump-start) 3 forwards;
    }
  }

  .playback[data-action="play"] :global([data-icon="pause"]),
  .playback[data-action="pause"] :global([data-icon="play"]) {
    display: none;
  }

  .phase {
    overflow: hidden;
    line-height: 1.2;
    block-size: 1.2em;
    text-align: end;
    pointer-events: none;
  }

  .phase :global(.phase-track) {
    display: flex;
    flex-direction: column;
    align-items: end;
    will-change: transform;
  }

  .phase :global(.phase-label) {
    display: block;
    flex: 0 0 1.2em;
    block-size: 1.2em;
    line-height: 1.2;
    white-space: nowrap;
    text-align: end;
    color: var(--color-digit, var(--color-fg));
  }

  .phase[data-tone="work"],
  .phase :global(.phase-label[data-tone="work"]) {
    color: var(--color-work);
  }

  .phase[data-tone="rest"],
  .phase :global(.phase-label[data-tone="rest"]) {
    color: var(--color-rest);
  }

  @media (min-aspect-ratio: 1000/600) {
    .timer-player {
      grid-template-areas:
        "time rings"
        "status rings";
    }

    .rings {
      flex-direction: column;
    }
  }
</style>
