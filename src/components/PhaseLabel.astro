---
import { LABEL } from "../scripts/labels.js";

interface Props {
  label?: string;
}

const { label = LABEL.idle } = Astro.props;
---

<phase-label class="phase" aria-live="polite" aria-label={label}>
  <div class="phase-track" aria-hidden="true">
    <div class="phase-label">{label}</div>
  </div>
</phase-label>

<script>
  import { LABEL } from "../scripts/labels.js";
  import { toPhaseType } from "../scripts/model.js";

  const SLIDE_MS = 200;
  const LINE = "1lh";
  const SLIDE_DOWN = new Set([LABEL.prepare, LABEL.paused]);
  /** Shared display copy — LABEL.start and LABEL.idle are both "Start". */
  const START_COPY = new Set([LABEL.start, LABEL.idle]);

  /**
   * Light-DOM phase label with slide transitions. Markup comes from Astro.
   */
  class PhaseLabelElement extends HTMLElement {
    #track: HTMLElement | null = null;
    #label: HTMLElement | null = null;
    #text = "";
    /** @type {"work" | "rest" | null} */
    #tone: "work" | "rest" | null = null;
    /** @type {{ stop: () => void } | null} */
    #active: { stop: () => void } | null = null;
    #ready = false;

    connectedCallback() {
      if (this.#ready) return;

      this.#track = this.#ensureTrack();
      this.#track.setAttribute("aria-hidden", "true");
      this.#label = this.#track.querySelector(".phase-label");
      this.#text = this.#label?.textContent ?? "";
      this.#tone = toPhaseType(this.#label?.dataset.tone ?? this.dataset.tone);

      if (this.#text) this.setAttribute("aria-label", this.#text);
      this.#ready = true;
    }

    getText() {
      return this.#text;
    }

    /**
     * @param {string} next
     * @param {{ tone?: string | null, animate?: boolean, from?: "bottom" | "top" }} [opts]
     */
    set(next: string, { tone: nextTone = null, animate: shouldAnimate = true, from }: {
      tone?: string | null;
      animate?: boolean;
      from?: "bottom" | "top";
    } = {}) {
      if (!this.#ready) this.connectedCallback();

      const resolvedTone = toPhaseType(nextTone);
      if (next === this.#text && resolvedTone === this.#tone && !this.#active) return;

      if (next === LABEL.complete) {
        this.#snap(next, resolvedTone);
        return;
      }

      if (START_COPY.has(next) && (this.#text === LABEL.complete || this.#text === LABEL.paused)) {
        this.#snap(next, resolvedTone);
        return;
      }

      if (shouldAnimate && this.#text && next !== this.#text) {
        const direction = from ?? (SLIDE_DOWN.has(next) ? "top" : "bottom");
        this.#slide(next, resolvedTone, direction);
        return;
      }

      this.#snap(next, resolvedTone);
    }

    #ensureTrack() {
      const existing = this.querySelector(".phase-track");
      if (existing instanceof HTMLElement) return existing;

      const el = document.createElement("div");
      el.className = "phase-track";
      el.setAttribute("aria-hidden", "true");
      const label = this.querySelector(".phase-label");
      if (label) el.append(label);
      else if (this.textContent?.trim()) {
        const next = document.createElement("div");
        next.className = "phase-label";
        next.textContent = this.textContent.trim();
        el.append(next);
      }
      this.replaceChildren(el);
      return el;
    }

    /** @param {string} next @param {"work" | "rest" | null} nextTone */
    #makeLabel(next: string, nextTone: "work" | "rest" | null) {
      const el = document.createElement("div");
      el.className = "phase-label";
      el.textContent = next;
      if (nextTone) el.dataset.tone = nextTone;
      return el;
    }

    /** @param {"work" | "rest" | null} nextTone */
    #applyRootTone(nextTone: "work" | "rest" | null) {
      if (nextTone) this.dataset.tone = nextTone;
      else delete this.dataset.tone;
    }

    /** @param {string} next @param {"work" | "rest" | null} nextTone */
    #snap(next: string, nextTone: "work" | "rest" | null) {
      const track = this.#track ?? this.#ensureTrack();
      this.#track = track;
      this.#active?.stop();
      this.#active = null;
      track.removeAttribute("style");
      if (!this.#label) this.#label = this.#makeLabel(next, nextTone);
      else {
        this.#label.textContent = next;
        if (nextTone) this.#label.dataset.tone = nextTone;
        else delete this.#label.dataset.tone;
      }
      track.replaceChildren(this.#label);
      this.replaceChildren(track);
      this.setAttribute("aria-label", next);
      this.#applyRootTone(nextTone);
      this.#text = next;
      this.#tone = nextTone;
    }

    /**
     * @param {string} next
     * @param {"work" | "rest" | null} nextTone
     * @param {"bottom" | "top"} [from]
     */
    #slide(next: string, nextTone: "work" | "rest" | null, from: "bottom" | "top" = "bottom") {
      if (!this.#label || matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.#snap(next, nextTone);
        return;
      }

      const track = this.#track ?? this.#ensureTrack();
      this.#track = track;
      this.#active?.stop();

      const outgoing = this.#label;
      if (this.#tone) outgoing.dataset.tone = this.#tone;
      const incoming = this.#makeLabel(next, nextTone);
      const fromTop = from === "top";
      const start = fromTop ? `translateY(-${LINE})` : "translateY(0)";
      const end = fromTop ? "translateY(0)" : `translateY(-${LINE})`;

      track.style.transition = "none";
      track.replaceChildren(...(fromTop ? [incoming, outgoing] : [outgoing, incoming]));
      track.style.transform = start;
      void track.offsetWidth;
      track.style.removeProperty("transition");
      track.style.transform = end;

      this.setAttribute("aria-label", next);
      delete this.dataset.tone;

      this.#text = next;
      this.#tone = nextTone;
      this.#label = incoming;

      let settled = false;
      const settle = () => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        track.removeEventListener("transitionend", onEnd);
        if (this.#active !== controls) return;
        this.#active = null;
        outgoing.remove();
        track.removeAttribute("style");
        this.#applyRootTone(nextTone);
      };

      /** @type {{ stop: () => void }} */
      const controls = {
        stop: () => {
          if (settled) return;
          settled = true;
          window.clearTimeout(timer);
          track.removeEventListener("transitionend", onEnd);
          queueMicrotask(() => {
            if (this.#active !== controls) return;
            this.#active = null;
            this.#snap(next, nextTone);
          });
        },
      };

      /** @param {Event} event */
      const onEnd = (event) => {
        if (event.target !== track || !(event instanceof TransitionEvent) || event.propertyName !== "transform")
          return;
        settle();
      };

      track.addEventListener("transitionend", onEnd);
      const timer = window.setTimeout(settle, SLIDE_MS + 200);
      this.#active = controls;
    }
  }

  if (!customElements.get("phase-label")) {
    customElements.define("phase-label", PhaseLabelElement);
  }
</script>

<style>
  .phase {
    overflow: hidden;
    line-height: 1;
    block-size: 1lh;
    text-align: end;
    pointer-events: none;
  }

  .phase :global(.phase-track) {
    display: flex;
    flex-direction: column;
    align-items: end;
    transition: transform 200ms steps(3, jump-end);
  }

  @media (prefers-reduced-motion: reduce) {
    .phase :global(.phase-track) {
      transition: none;
    }
  }

  .phase :global(.phase-label) {
    display: block;
    flex: 0 0 1.2em;
    block-size: 1lh;
    line-height: 1;
    white-space: nowrap;
    text-align: end;
    color: var(--color-digit, var(--color-fg));
  }

  .phase[data-tone="work"],
  .phase :global(.phase-label[data-tone="work"]) {
    color: var(--color-work);
  }

  .phase[data-tone="rest"],
  .phase :global(.phase-label[data-tone="rest"]) {
    color: var(--color-rest);
  }

  :global([data-status="preparing"]) .phase {
    animation: pulse 1s steps(1, jump-end) 3;
  }

  :global([data-status="complete"]) .phase :global(.phase-label) {
    animation: pulse 1s steps(1, jump-end) 3 forwards;
  }
</style>
