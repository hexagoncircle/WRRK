---
import { LABEL } from "../scripts/labels.js";

interface Props {
  label?: string;
}

const { label = LABEL.start } = Astro.props;
---

<phase-label class="phase" aria-live="polite" aria-label={label}>
  <div class="phase-track" aria-hidden="true">
    <div class="phase-label">{label}</div>
  </div>
</phase-label>

<script>
  import { LABEL } from "../scripts/labels.js";
  import { toPhaseType } from "../scripts/model.js";

  const SLIDE = {
    bottom: { enter: "enter-bottom", exit: "exit-up" },
    top: { enter: "enter-top", exit: "exit-down" },
  };
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  type PhaseType = "work" | "rest" | null;
  type SlideFrom = "bottom" | "top";
  type SlideControls = { stop: () => void };

  function phaseType(text: string): PhaseType {
    if (text === LABEL.work) return "work";
    if (text === LABEL.rest) return "rest";
    return null;
  }

  class PhaseLabel extends HTMLElement {
    #track: HTMLElement | null = null;
    #label: HTMLElement | null = null;
    #text = "";
    #type: PhaseType = null;
    #active: SlideControls | null = null;
    #ready = false;

    connectedCallback() {
      if (this.#ready) return;

      this.#track = this.#ensureTrack();
      this.#track.setAttribute("aria-hidden", "true");
      this.#label = this.#track.querySelector(".phase-label");
      this.#text = this.#label?.textContent ?? "";
      this.#type = toPhaseType(this.#label?.dataset.type ?? this.dataset.type);

      if (this.#text) this.setAttribute("aria-label", this.#text);
      this.#ready = true;
    }

    getText() {
      return this.#text;
    }

    /**
     * @param {(typeof LABEL)[keyof typeof LABEL]} next
     * @param {boolean} [animate]
     */
    set(next: (typeof LABEL)[keyof typeof LABEL], animate = true) {
      if (!this.#ready) this.connectedCallback();

      const nextType = phaseType(next);
      if (next === this.#text && nextType === this.#type && !this.#active) return;

      if (this.#shouldSnap(next, animate)) {
        this.#snap(next, nextType);
        return;
      }

      const from = [LABEL.prepare, LABEL.paused].includes(next) ? "top" : "bottom";
      this.#slide(next, nextType, from);
    }

    /**
     * Slide only when the visible copy changes and animation is allowed.
     * Complete, and Start after Complete or Paused, always cut.
     */
    #shouldSnap(next: string, animate: boolean) {
      if (!animate || !this.#text || next === this.#text) return true;
      if (next === LABEL.complete) return true;
      const leavingTerminal = this.#text === LABEL.complete || this.#text === LABEL.paused;
      return next === LABEL.start && leavingTerminal;
    }

    #ensureTrack() {
      const existing = this.querySelector(".phase-track");
      if (existing instanceof HTMLElement) return existing;

      const track = document.createElement("div");
      track.className = "phase-track";
      track.setAttribute("aria-hidden", "true");
      const label = this.querySelector(".phase-label");
      if (label) {
        track.append(label);
      } else if (this.textContent?.trim()) {
        const next = document.createElement("div");
        next.className = "phase-label";
        next.textContent = this.textContent.trim();
        track.append(next);
      }
      this.replaceChildren(track);
      return track;
    }

    #makeLabel(next: string, nextType: PhaseType) {
      const el = document.createElement("div");
      el.className = "phase-label";
      el.textContent = next;
      this.#setType(el, nextType);
      return el;
    }

    #setType(el: HTMLElement, type: PhaseType) {
      if (type) el.dataset.type = type;
      else delete el.dataset.type;
    }

    #snap(next: string, nextType: PhaseType) {
      this.#track ??= this.#ensureTrack();
      const track = this.#track;
      this.#active?.stop();
      this.#active = null;

      if (!this.#label) this.#label = this.#makeLabel(next, nextType);
      else {
        this.#label.textContent = next;
        this.#setType(this.#label, nextType);
      }

      delete this.#label.dataset.motion;
      track.replaceChildren(this.#label);
      this.replaceChildren(track);
      this.setAttribute("aria-label", next);
      this.#setType(this, nextType);
      this.#text = next;
      this.#type = nextType;
    }

    #slide(next: string, nextType: PhaseType, from: SlideFrom) {
      if (!this.#label || reducedMotion.matches) {
        this.#snap(next, nextType);
        return;
      }

      this.#track ??= this.#ensureTrack();
      const track = this.#track;
      this.#active?.stop();

      const outgoing = this.#label;
      if (this.#type) this.#setType(outgoing, this.#type);
      const incoming = this.#makeLabel(next, nextType);
      const motion = SLIDE[from];

      outgoing.dataset.motion = motion.exit;
      incoming.dataset.motion = motion.enter;
      track.replaceChildren(outgoing, incoming);

      this.setAttribute("aria-label", next);
      this.#setType(this, null);
      this.#text = next;
      this.#type = nextType;
      this.#label = incoming;

      let settled = false;

      const release = () => {
        outgoing.removeEventListener("animationend", onEnd);
      };

      const settle = () => {
        if (settled) return;
        settled = true;
        release();
        if (this.#active !== controls) return;
        this.#active = null;
        outgoing.remove();
        delete incoming.dataset.motion;
        this.#setType(this, nextType);
      };

      const controls: SlideControls = {
        stop: () => {
          if (settled) return;
          settled = true;
          release();
          // A newer set() replaces #active before this microtask. Snap only
          // if this slide is still the one in charge.
          queueMicrotask(() => {
            if (this.#active !== controls) return;
            this.#active = null;
            this.#snap(next, nextType);
          });
        },
      };

      const onEnd = (event: Event) => {
        if (event.target !== outgoing) return;
        settle();
      };

      outgoing.addEventListener("animationend", onEnd);
      this.#active = controls;
    }
  }

  if (!customElements.get("phase-label")) {
    customElements.define("phase-label", PhaseLabel);
  }
</script>

<style>
  .phase {
    --duration: 200ms;
    --phase-line: 1lh;
    --phase-pulse: pulse 1s steps(1, jump-end) 3;

    overflow: hidden;
    line-height: 1;
    block-size: var(--phase-line);
    text-align: end;
    pointer-events: none;
  }

  .phase :global(.phase-track) {
    display: grid;
    justify-items: end;
  }

  .phase :global(.phase-label) {
    grid-area: 1 / 1;
    translate: 0;
    block-size: var(--phase-line);
    white-space: nowrap;
    color: var(--color-digit, var(--color-fg));
  }

  .phase :global(.phase-label[data-motion="enter-bottom"]) {
    animation: phase-enter-bottom var(--duration) steps(3, jump-end) both;
  }

  .phase :global(.phase-label[data-motion="enter-top"]) {
    animation: phase-enter-top var(--duration) steps(3, jump-end) both;
  }

  .phase :global(.phase-label[data-motion="exit-up"]) {
    animation: phase-exit-up var(--duration) steps(3, jump-end) both;
  }

  .phase :global(.phase-label[data-motion="exit-down"]) {
    animation: phase-exit-down var(--duration) steps(3, jump-end) both;
  }

  @keyframes phase-enter-bottom {
    from {
      translate: 0 100%;
    }
  }

  @keyframes phase-enter-top {
    from {
      translate: 0 -100%;
    }
  }

  @keyframes phase-exit-up {
    to {
      translate: 0 -100%;
    }
  }

  @keyframes phase-exit-down {
    to {
      translate: 0 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phase :global(.phase-label[data-motion]) {
      animation: none;
    }
  }

  .phase[data-type="work"],
  .phase :global(.phase-label[data-type="work"]) {
    color: var(--color-work);
  }

  .phase[data-type="rest"],
  .phase :global(.phase-label[data-type="rest"]) {
    color: var(--color-rest);
  }

  :global([data-status="preparing"]) .phase {
    animation: var(--phase-pulse);
  }

  :global([data-status="complete"]) .phase :global(.phase-label) {
    animation: var(--phase-pulse);
    animation-fill-mode: forwards;
  }
</style>
