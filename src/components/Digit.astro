---
const { digit } = Astro.props;
---

<svg
  class="digit"
  width="96"
  height="179"
  viewBox="0 0 96 179"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  data-digit={digit}
  aria-hidden="true"
>
  <path
    class="top"
    d="M91.0721 2.75813C88.9439 1.03563 86.2463 0 83.3067 0H12.4352C9.39593 0 6.61287 1.10325 4.45264 2.93251L22.5033 21.1682H72.8471L91.0721 2.75813Z"
    fill="currentColor"></path>
  <path
    class="top-right"
    d="M75.2275 22.7946V77.6084L89.5236 88.6124L95.7445 83.8257V12.5628C95.7445 9.61961 94.7338 6.92198 93.0575 4.77954L75.2275 22.7946Z"
    fill="currentColor"></path>
  <path
    class="bottom-right"
    d="M93.2248 173.175C94.7978 171.072 95.7445 168.459 95.7445 165.616V95.015L89.5236 90.2283L75.2275 101.232V154.993L93.2248 173.175Z"
    fill="currentColor"></path>
  <path
    class="bottom"
    d="M73.2384 157.01H22.101L4.24609 175.054C6.4348 176.993 9.29614 178.182 12.4351 178.182H83.3065C86.3458 178.182 89.1288 177.075 91.289 175.246L73.2384 157.01Z"
    fill="currentColor"></path>
  <path
    class="bottom-left"
    d="M20.5169 154.583V101.232L6.22095 90.2283L0 95.015V165.616C0 168.353 0.875515 170.88 2.34533 172.94L20.5169 154.583Z"
    fill="currentColor"></path>
  <path
    class="top-left"
    d="M2.51615 5.00732C0.943126 7.11062 0 9.72283 0 12.5628V83.8257L6.22095 88.6124L20.5169 77.6084V23.1932L2.51615 5.00732Z"
    fill="currentColor"></path>
  <path
    class="middle"
    d="M71.4021 78.2847H24.3395L9.86914 89.4204L24.3395 100.556H71.4021L85.8725 89.4204L71.4021 78.2847Z"
    fill="currentColor"></path>
</svg>

<style>
  .digit {
    width: 100%;
    height: auto;

    path {
      fill: var(--color-fg-subtle);
    }
  }

  [data-digit="0"] :is(.top, .top-right, .bottom-right, .bottom, .bottom-left, .top-left),
  [data-digit="1"] :is(.top-right, .bottom-right),
  [data-digit="2"] :is(.top, .top-right, .bottom, .bottom-left, .middle),
  [data-digit="3"] :is(.top, .top-right, .bottom-right, .bottom, .middle),
  [data-digit="4"] :is(.top-right, .bottom-right, .top-left, .middle),
  [data-digit="5"] :is(.top, .bottom-right, .bottom, .top-left, .middle),
  [data-digit="6"] :is(.top, .bottom-right, .bottom, .bottom-left, .top-left, .middle),
  [data-digit="7"] :is(.top, .top-right, .bottom-right),
  [data-digit="8"] :is(.top, .top-right, .bottom-right, .bottom, .bottom-left, .top-left, .middle),
  [data-digit="9"] :is(.top, .top-right, .bottom-right, .top-left, .middle) {
    fill: var(--color-digit, var(--color-fg));
  }
</style>
