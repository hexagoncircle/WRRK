---
import Ring from "./Ring.astro";
import { phasePercents } from "../scripts/progress-ring.js";

export interface Props {
  work: number;
  rest: number;
  class?: string;
}

const { work, rest, class: className, ...attrs } = Astro.props;
const { workPercent, restPercent } = phasePercents(work, rest);
---

<Ring
  class:list={["progress-ring", className]}
  style={`
    --progress-work-percent: ${workPercent};
    --progress-rest-percent: ${restPercent};
  `}
  {...attrs}
>
  <g data-phase="work" style="--phase-progress: 100;">
    <circle class="progress-track" cx="50" cy="50" r="45" pathLength="100"></circle>
    <circle class="progress-fill" cx="50" cy="50" r="45" pathLength="100"></circle>
  </g>
  <g data-phase="rest" style="--phase-progress: 100;">
    <circle class="progress-track" cx="50" cy="50" r="45" pathLength="100"></circle>
    <circle class="progress-fill" cx="50" cy="50" r="45" pathLength="100"></circle>
  </g>
  <div class="progress-dot" slot="center"></div>
</Ring>

<style>
  [data-phase] {
    --duration: 0.4s;
    transform-origin: center;
    transform-box: view-box;
    transition: --phase-progress var(--duration) linear;
  }

  circle {
    stroke: currentcolor;
    stroke-dasharray: var(--arc-length) 100;
    /* Hide round linecap when dash length is 0 */
    opacity: min(1, var(--arc-length));
  }

  .progress-track {
    color: var(--color-fg-subtle);
    stroke-dashoffset: 0;
  }

  .progress-fill {
    stroke: var(--progress-fill-stroke);
    stroke-dashoffset: calc(var(--arc-length) * (1 - var(--phase-progress) / 100));
    opacity: min(1, var(--phase-progress), var(--arc-length));
  }

  [data-phase="work"] {
    --arc-length: max(0, calc(var(--progress-work-percent) - var(--ring-gap)));
    --progress-fill-stroke: var(--color-work);
    transform: rotate(calc(var(--ring-gap) * 2deg));
  }

  [data-phase="rest"] {
    --arc-length: max(0, calc(var(--progress-rest-percent) - var(--ring-gap)));
    --progress-fill-stroke: var(--color-rest);
    transform: rotate(calc(var(--ring-gap) * 2deg + var(--progress-work-percent) * 3.6deg));
  }

  :global([data-status="complete"]) [data-phase] {
    --progress-fill-stroke: var(--color-digit, var(--color-fg));
  }

  .progress-dot {
    --size: 0.6em;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background-color: var(--color-fg);
  }

  /* [data-phase] for the blinking dot lives on the app root, not these <g>s. */
  :global([data-phase="work"]) .progress-dot {
    animation: dot-work 0.5s steps(1) infinite;
  }

  :global([data-phase="rest"]) .progress-dot {
    animation: dot-rest 1s steps(3) infinite alternate;
  }

  :global([data-status="paused"]) .progress-dot {
    animation: none;
  }

  @keyframes dot-work {
    from {
      translate: -50% 0;
    }
    33% {
      translate: 0 -50%;
    }
    66% {
      translate: 50% 0;
    }
    to {
      translate: 0 0;
    }
  }

  @keyframes dot-rest {
    from {
      scale: 1;
    }
    to {
      scale: 1.6;
    }
  }
</style>
