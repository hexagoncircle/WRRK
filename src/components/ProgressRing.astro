---
import Ring from "./Ring.astro";
import { phasePercents } from "../scripts/progress-ring.js";

interface Props {
  work: number;
  rest: number;
  class?: string;
}

const { work, rest, class: className, ...attrs } = Astro.props;
const { workPercent, restPercent } = phasePercents(work, rest);
---

<progress-ring
  class:list={["progress-ring", className]}
  style={`--work-percent: ${workPercent}; --rest-percent: ${restPercent}`}
  {...attrs}
>
  <Ring>
    <g data-phase="work" style="--phase-progress: 100;">
      <circle class="track" cx="50" cy="50" r="45" pathLength="100"></circle>
      <circle class="fill" cx="50" cy="50" r="45" pathLength="100"></circle>
    </g>
    <g data-phase="rest" style="--phase-progress: 100;">
      <circle class="track" cx="50" cy="50" r="45" pathLength="100"></circle>
      <circle class="fill" cx="50" cy="50" r="45" pathLength="100"></circle>
    </g>
    <div class="dot" slot="center"></div>
  </Ring>
</progress-ring>

<script>
  import { clampNumber } from "../scripts/utils.js";
  import { phasePercents } from "../scripts/progress-ring.js";

  class ProgressRing extends HTMLElement {
    $work!: SVGGElement;
    $rest!: SVGGElement;
    #prevWork = 0;
    #prevRest = 0;
    #transitionSeconds = 0;

    connectedCallback() {
      this.$work = this.querySelector('[data-phase="work"]') as SVGGElement;
      this.$rest = this.querySelector('[data-phase="rest"]') as SVGGElement;
      this.#transitionSeconds =
        Number.parseFloat(getComputedStyle(this).getPropertyValue("--duration")) || 0;
    }

    setTotals(workSeconds: number, restSeconds: number, { fill = true }: { fill?: boolean } = {}) {
      const { workPercent, restPercent } = phasePercents(workSeconds, restSeconds);
      this.style.setProperty("--work-percent", String(workPercent));
      this.style.setProperty("--rest-percent", String(restPercent));
      if (fill) this.#paint(100, 100, { instant: true });
    }

    setProgress(
      {
        phase,
        remainingSeconds,
        durationSeconds,
      }: {
        phase: "work" | "rest" | null;
        remainingSeconds: number;
        durationSeconds: number;
      },
      { settle = false }: { settle?: boolean } = {},
    ) {
      const duration = Math.max(0, Number(durationSeconds) || 0);
      const remaining = Math.max(0, Number(remainingSeconds) || 0);
      const elapsed = duration === 0 ? 0 : duration - remaining;
      const actual = this.#valuesForPhase(phase, this.#progressAt(elapsed, duration));

      if (settle) {
        this.#paint(actual.work, actual.rest, { instant: true });
        return;
      }

      // Lead by transition length so CSS catches up as the next tick arrives.
      const leadSec = Math.min(this.#transitionSeconds, remaining);
      const led = this.#valuesForPhase(
        phase,
        this.#progressAt(Math.min(duration, elapsed + leadSec), duration),
      );

      const workInstant = led.work < this.#prevWork - 0.001;
      const restInstant = led.rest < this.#prevRest - 0.001;
      const work = workInstant ? actual.work : led.work;
      const rest = restInstant ? actual.rest : led.rest;

      this.#setPhaseProgress(this.$work, work, {
        instant: workInstant,
        durationSeconds: leadSec,
      });
      this.#setPhaseProgress(this.$rest, rest, {
        instant: restInstant,
        durationSeconds: leadSec,
      });
      this.#prevWork = work;
      this.#prevRest = rest;
    }

    reset() {
      this.#paint(0, 0, { instant: true });
    }

    #setPhaseProgress(
      el: SVGGElement,
      value: number,
      {
        instant = false,
        durationSeconds = this.#transitionSeconds,
      }: {
        instant?: boolean;
        durationSeconds?: number;
      } = {},
    ) {
      if (durationSeconds >= this.#transitionSeconds - 0.001) {
        el.style.removeProperty("--duration");
      } else {
        el.style.setProperty("--duration", `${Math.max(0, durationSeconds)}s`);
      }

      if (instant) el.style.transition = "none";
      el.style.setProperty("--phase-progress", String(value));
      if (instant) {
        el.getBoundingClientRect();
        el.style.removeProperty("transition");
      }
    }

    #paint(workProgress: number, restProgress: number, { instant = false } = {}) {
      this.#setPhaseProgress(this.$work, workProgress, { instant });
      this.#setPhaseProgress(this.$rest, restProgress, { instant });
      this.#prevWork = workProgress;
      this.#prevRest = restProgress;
    }

    #progressAt(elapsed: number, duration: number) {
      if (duration <= 0) return 0;
      return clampNumber((elapsed / duration) * 100, 0, 100);
    }

    #valuesForPhase(phase: "work" | "rest" | null, progress: number) {
      if (phase === "work") return { work: progress, rest: 0 };
      if (phase === "rest") return { work: 100, rest: progress };
      return { work: 0, rest: 0 };
    }
  }

  if (!customElements.get("progress-ring")) {
    customElements.define("progress-ring", ProgressRing);
  }
</script>

<style>
  .progress-ring {
    --duration: 0.4s;
    display: block;
    min-width: 0;
  }

  [data-phase] {
    transform-origin: center;
    transform-box: view-box;
    transition: --phase-progress var(--duration) linear;
  }

  circle {
    stroke: currentcolor;
    stroke-dasharray: var(--arc-length) 100;
    /* Hide round linecap when dash length is 0 */
    opacity: min(1, var(--arc-length));
  }

  .track {
    color: var(--color-fg-subtle);
    stroke-dashoffset: 0;
  }

  .fill {
    stroke: var(--fill-stroke);
    stroke-dashoffset: calc(var(--arc-length) * (1 - var(--phase-progress) / 100));
    opacity: min(1, var(--phase-progress), var(--arc-length));
  }

  [data-phase="work"] {
    --arc-length: max(0, calc(var(--work-percent) - var(--ring-gap)));
    --fill-stroke: var(--color-work);
    transform: rotate(calc(var(--ring-gap) * 2deg));
  }

  [data-phase="rest"] {
    --arc-length: max(0, calc(var(--rest-percent) - var(--ring-gap)));
    --fill-stroke: var(--color-rest);
    transform: rotate(calc(var(--ring-gap) * 2deg + var(--work-percent) * 3.6deg));
  }

  :global([data-status="complete"]) [data-phase] {
    --fill-stroke: var(--color-digit, var(--color-fg));
  }

  .dot {
    --size: 0.75em;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background-color: var(--color-digit, var(--color-fg));
  }

  /* [data-phase] for the blinking dot lives on the app root, not these <g>s. */
  :global([data-phase="rest"]) .dot {
    animation: dot-pulse 1s steps(3) infinite alternate;
  }

  :global([data-phase="work"]) .dot {
    animation: dot-work 0.5s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-phase="work"]) .dot {
      animation: dot-work-scale 0.5s steps(1) infinite;
    }
  }

  :global([data-status="paused"]) .dot {
    animation: none;
  }

  @keyframes dot-work {
    from {
      translate: -50% 0;
    }
    33% {
      translate: 0 -50%;
    }
    66% {
      translate: 50% 0;
    }
    to {
      translate: 0 0;
    }
  }

  @keyframes dot-work-scale {
    0% {
      scale: 1;
    }
    50% {
      scale: 1.1;
    }
    100% {
      scale: 1;
    }
  }

  @keyframes dot-pulse {
    from {
      scale: 1;
    }
    to {
      scale: 1.6;
    }
  }
</style>
