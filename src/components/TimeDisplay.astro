---
import Digit from "./Digit.astro";
---

<time-display class="time" datetime="PT0M0S" aria-label="0:00" role="timer">
  <Digit digit={0} />
  <span class="time-separator"></span>
  <Digit digit={0} />
  <Digit digit={0} />
</time-display>

<script>
  import { formatDurationAttr, formatMSS } from "../scripts/utils.js";

  /**
   * Light-DOM clock face. Markup comes from Astro; digits stay as SVG children.
   */
  class TimeDisplayElement extends HTMLElement {
    #digits: NodeListOf<Element> | null = null;
    #ready = false;

    connectedCallback() {
      if (this.#ready) return;
      this.#digits = this.querySelectorAll("[data-digit]");
      this.#ready = true;
    }

    get digits() {
      if (!this.#ready) this.connectedCallback();
      return this.#digits ?? this.querySelectorAll("[data-digit]");
    }

    get dateTime() {
      return this.getAttribute("datetime") ?? "";
    }

    set dateTime(value: string) {
      this.setAttribute("datetime", value);
    }

    /**
     * Map a whole-second countdown onto the digit SVGs (M:SS, max 9:59).
     * @param {number} seconds
     */
    setTime(seconds: number) {
      if (!this.#ready) this.connectedCallback();

      const label = formatMSS(seconds);
      const [mins, secs] = label.split(":");
      const values = [mins, secs[0], secs[1]];

      [...this.digits].forEach((el, i) => {
        if (!(el instanceof Element)) return;
        const digit = values[i] ?? "0";
        if (el.dataset.digit !== digit) {
          el.dataset.digit = digit;
        }
      });

      this.dateTime = formatDurationAttr(seconds);
      this.setAttribute("aria-label", label);
    }

    /** @param {number} n */
    setCountdownLabel(n: number) {
      this.dateTime = `PT${n}S`;
      this.setAttribute("aria-label", String(n));
    }
  }

  if (!customElements.get("time-display")) {
    customElements.define("time-display", TimeDisplayElement);
  }
</script>

<style>
  .time {
    grid-area: time;
    display: flex;
    gap: 1.2em;
    inline-size: 18em;
    font-variant-numeric: tabular-nums;
    transition: opacity 300ms ease-out;
  }

  .time-separator {
    --size: 0.6em;
    display: flex;
    align-self: center;
    flex-direction: column;
    row-gap: calc(var(--size) * 2.5);

    &::before,
    &::after {
      content: "";
      display: block;
      width: var(--size);
      height: var(--size);
      background-color: var(--color-digit, var(--color-fg));
      border-radius: 50%;
      transition: background-color 1s steps(1, jump-start);
    }
  }

  :global([data-status="preparing"]) .time-separator {
    --color-digit: var(--color-fg-subtle);
  }

  :global([data-status="countdown"]) .time-separator {
    --color-digit: var(--color-fg-subtle);

    &::before {
      transition-delay: 2s;
    }
    &::after {
      transition-delay: 1s;
    }
  }

  :global([data-status="paused"]) .time {
    opacity: 0.25;
  }

  :global([data-status="paused"]) .time-separator,
  :global([data-status="paused"]) .time :global(.digit path) {
    animation: pulse 1s steps(1, jump-end) infinite;
  }

  :global([data-status="complete"]) .time-separator,
  :global([data-status="complete"]) .time :global(.digit path) {
    animation: pulse 1s steps(1, jump-end) 3 forwards;
  }
</style>
