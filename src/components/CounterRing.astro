---
import Ring from "./Ring.astro";

interface Props {
  count: number;
  class?: string;
}

const { count, class: className, ...rest } = Astro.props;
---

<Ring class:list={["counter-ring", className]} style={`--count: ${count}`} {...rest}>
  <circle class="counter-track" cx="50" cy="50" r="45" pathLength="100"></circle>
  <circle class="counter-fill" cx="50" cy="50" r="45" pathLength="100"></circle>
  <circle class="counter-active" cx="50" cy="50" r="45" pathLength="100"></circle>
  <div class="counter-text" slot="center">
    <span class="current">1</span>
    <span class="sep">/</span>
    <span class="total">{count}</span>
  </div>
</Ring>
