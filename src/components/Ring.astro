---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={["ring", className]} {...rest}>
  <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <slot />
  </svg>
  <slot name="center" />
</div>

<style>
  .ring {
    display: grid;
    grid-template-areas: "cell";
    place-items: center;
    min-width: 0;
    inline-size: 6em;
  }

  .ring > :global(*) {
    grid-area: cell;
    place-content: center;
    text-align: center;
  }

  .ring > :global(svg) {
    transform: rotate(-90deg);
    transform-origin: center;
    transform-box: view-box;
  }

  .ring > :global(:not(svg)) {
    place-self: center;
  }

  .ring :global(circle) {
    fill: none;
    stroke-width: var(--ring-stroke);
    stroke-linecap: var(--segment-linecap, round);
  }

  @media (min-aspect-ratio: 3/2) {
    .ring {
      inline-size: 5em;
    }
  }
</style>
